{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigil AI Agent",
  "version": "4.0.0",
  "identifier": "com.vigil.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vigil AI Agent",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/authenticate.swift",
      "resources/verify_password.swift",
      "resources/dictate_live.swift"
    ],
    "externalBin": [],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:vigil.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vigil"]
      }
    }
  }
}
