# Vigil Desktop — copy to .env.local (not Vercel; web env lives in Vigil-AI-Agent-Web)
# Match NEXT_PUBLIC_FIREBASE_* from the web project (same Firebase app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Hosted Vigil Web (User shell) — desktop opens this in an embed tab (?embed=1)
# Local Next: http://127.0.0.1:3000
VITE_VIGIL_WEB_URL=https://agent.vigilhub.app
